<?xml version="1.0"?>
<ruleset name="AI Provider for Gisoo">
	<description>Coding standards for AI Provider for Gisoo.</description>
	<file>.</file>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="text_domain" value="ai-provider-for-gisoo"/>
	<rule ref="WordPress.Files.FileName">
		<!-- PSR-4 class files in src/, the layout PHP AI Client providers use. -->
		<exclude-pattern>/src/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.IncorrectTypeHint">
		<!-- The signature is dictated by the parent class. -->
		<exclude-pattern>/src/Models/*</exclude-pattern>
	</rule>
</ruleset>
